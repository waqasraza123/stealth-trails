# API base URL (NestJS default in dev: http://localhost:9001)
# Production: /api (proxied to https://api.stealth-trails.space by vercel.json)
VITE_SERVER_URL=http://localhost:9001
# Optional override. Defaults to <VITE_SERVER_URL>/client-events/events
VITE_TELEMETRY_ENDPOINT=
VITE_TELEMETRY_ENVIRONMENT=development
VITE_TELEMETRY_RELEASE=local

# Public homepage contact links (included in the client build).
# Without an Upwork URL, the CTA shows the portfolio link only.
VITE_UPWORK_PROFILE_URL=
# Defaults to https://github.com/waqasraza123
VITE_PORTFOLIO_URL=
