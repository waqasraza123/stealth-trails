# API server
API_PORT=9001
# Required in production. Comma-separated bare origins only, for example:
# CORS_ALLOWED_ORIGINS=https://stealth-trails.space,https://www.stealth-trails.space,https://admin.stealth-trails.space,https://m.stealth-trails.space
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Wealth Brief. Disabled is the safe default and produces a deterministic
# preview. When enabled, the API still requires explicit customer opt-in for
# each request before sending the disclosed minimized snapshot externally.
# The provider endpoint is SSRF-hardened: its host must exactly match
# AI_WEALTH_BRIEF_ALLOWED_HOSTS, HTTPS is required, embedded credentials,
# IP literals, loopback/internal hosts, query strings, and HTTP redirects are
# all rejected, and the API key is only held server-side. Validation is
# hostname-based at startup; the HTTP client does not pin resolved IPs, so
# only allow-list fixed provider hosts whose DNS you trust.
AI_WEALTH_BRIEF_PROVIDER=disabled
# AI_WEALTH_BRIEF_ENDPOINT=https://provider.example.com/v1/chat/completions
# AI_WEALTH_BRIEF_ALLOWED_HOSTS=provider.example.com
# AI_WEALTH_BRIEF_API_KEY=
# AI_WEALTH_BRIEF_MODEL=
# AI_WEALTH_BRIEF_REQUEST_TIMEOUT_MS=12000
# AI_WEALTH_BRIEF_MAX_OUTPUT_TOKENS=700
# Development-only exception for a local mock provider. Permits plain HTTP to
# loopback hosts and loopback/private allow-list entries. Never allowed when
# NODE_ENV=production (config load fails closed).
# AI_WEALTH_BRIEF_ALLOW_LOCAL_PROVIDER=false

# Opportunity Intelligence market data. Disabled remains the safe default.
# CoinGecko uses a fixed HTTPS endpoint with redirects disabled; the optional
# demo API key stays server-side. Asset IDs are allow-listed identifier strings.
MARKET_DATA_PROVIDER=disabled
# MARKET_DATA_PROVIDER=coingecko
# COINGECKO_API_KEY=
# MARKET_DATA_ASSET_IDS=ethereum,lido-staked-ether,chainlink,aave,uniswap
# MARKET_DATA_REQUEST_TIMEOUT_MS=6000
# MARKET_DATA_CACHE_TTL_SECONDS=300
# MARKET_DATA_STALE_TTL_SECONDS=3600

# Preliminary halal-screening research thresholds. These defaults are exposed
# with every response and are not religious certification.
# HALAL_SCREENING_MAX_INTEREST_BEARING_DEBT_PERCENT=30
# HALAL_SCREENING_MAX_NON_PERMISSIBLE_INCOME_PERCENT=5

# Maximum customer-authorized Wealth Guardian reports generated by one worker
# sweep. Preferences are disabled by default and schedules use per-customer UTC hours.
# WEALTH_GUARDIAN_SCHEDULE_BATCH_SIZE=3

# Separate opt-in gate for the opportunity analyst. It also requires the
# secured AI provider above and explicit customer consent on every request.
# This path is hard-disabled by application code when NODE_ENV=production.
AI_OPPORTUNITY_ANALYST_ENABLED=false

# Separate opt-in gate for the Financial Copilot prioritizer. The copilot
# remains fully usable as a deterministic, cited preview when disabled. Even
# when enabled, the external model receives only intent/topic metadata and
# opaque statement IDs. This path is hard-disabled in production.
AI_COPILOT_ENABLED=false

# Separate model-directed Copilot research route; disabled in production.
# Uses the secured AI_WEALTH_BRIEF_* provider configuration above.
AI_RESEARCH_ENABLED=false
AI_RESEARCH_MAX_STEPS=8
AI_RESEARCH_MAX_TOOL_CALLS=12
AI_RESEARCH_TIMEOUT_MS=60000
AI_RESEARCH_MAX_TOKENS=48000
AI_RESEARCH_MAX_OUTPUT_TOKENS=1000
AI_RESEARCH_MAX_SPEND_USD=0.5
AI_RESEARCH_MAX_DAILY_SPEND_USD=30
# Operator-supplied upper bounds; set for the selected exact model.
# Actual billed cost remains unavailable without verified provider pricing.
AI_RESEARCH_INPUT_USD_PER_MILLION=10
AI_RESEARCH_OUTPUT_USD_PER_MILLION=30
# Security evaluation uses a separate entry point and dedicated environment.
AI_EVALUATION_ENABLED=false
# See evaluations/safelabs/.env.example and README.md for isolated setup.

# Investment Committee uses LangGraph tool calling only when this separate gate,
# the secured provider, and per-request customer consent are all enabled. This
# path is hard-disabled by application code when NODE_ENV=production.
AI_INVESTMENT_COMMITTEE_ENABLED=false
# Each graph node is bounded between 5 and 60 seconds. Read-only specialist
# nodes use one LangGraph retry; persisted plan and conversation writes do not.
AI_INVESTMENT_COMMITTEE_AGENT_TIMEOUT_MS=20000

# AI Agent Workflow Studio. Execution is invoked by the existing worker and
# remains limited to allow-listed read-only research tools.
# AI_WORKFLOW_WORKER_CONCURRENCY=2

# Financial Document Intelligence. External processing is disabled by default
# and hard-disabled in production. Every embedding/chat action also requires
# explicit customer consent. The database migration fixes vectors at 1536 dims.
DOCUMENT_AI_ENABLED=false
DOCUMENT_EMBEDDING_PROVIDER=disabled
# DOCUMENT_EMBEDDING_ENDPOINT=https://provider.example.com/v1/embeddings
# DOCUMENT_EMBEDDING_ALLOWED_HOSTS=provider.example.com
# DOCUMENT_EMBEDDING_API_KEY=
# DOCUMENT_EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_EMBEDDING_DIMENSIONS=1536
# DOCUMENT_EMBEDDING_REQUEST_TIMEOUT_MS=12000
# DOCUMENT_MAX_FILE_BYTES=10485760
# DOCUMENT_MAX_STORAGE_BYTES_PER_CUSTOMER=52428800
# DOCUMENT_MAX_PAGES=250
# DOCUMENT_MAX_CHUNKS=1000
# DOCUMENT_MAX_RETRIEVAL_RESULTS=8

# PostgreSQL (Prisma)
# Neon cutover target:
# - DATABASE_URL should use the Neon pooled/runtime URL with the -pooler host suffix
# - DIRECT_URL should use the Neon direct/unpooled URL for Prisma migrations
# - pg_dump and pg_restore must also use direct/unpooled source and target URLs
# Example pooled host shape: ep-example-pooler.<region>.aws.neon.tech
# Example direct host shape: ep-example.<region>.aws.neon.tech
DATABASE_URL=
DIRECT_URL=
# Local cutover helper inputs. Do not set these in browser-exposed envs.
# SOURCE_DATABASE_URL=
# SOURCE_SCHEMAS=public

# JWT Auth
JWT_SECRET=
JWT_EXPIRY_SECONDS=86400
# Required outside development. Generate independent high-entropy values and
# keep them in the deployment secret manager.
CUSTOMER_AUTH_HMAC_PEPPER=
# Base64-encoded 32-byte AES key used for TOTP secret encryption.
CUSTOMER_AUTH_ENCRYPTION_KEY=
CUSTOMER_AUTH_ENCRYPTION_KEY_VERSION=v1
CUSTOMER_WEB_SESSION_IDLE_SECONDS=900
CUSTOMER_WEB_SESSION_ABSOLUTE_SECONDS=43200
CUSTOMER_MOBILE_ACCESS_TOKEN_SECONDS=600
CUSTOMER_MOBILE_REFRESH_IDLE_SECONDS=86400
CUSTOMER_MOBILE_REFRESH_ABSOLUTE_SECONDS=604800

# Customer verification and security-code email delivery. Keep preview mode for
# local development. Production can use Resend directly with a verified sender.
CUSTOMER_MFA_EMAIL_DELIVERY_MODE=preview
# RESEND_API_KEY=
# CUSTOMER_MFA_EMAIL_DELIVERY_FROM_EMAIL=security@auth.example.com
CUSTOMER_MFA_EMAIL_DELIVERY_FROM_NAME=Stealth Trails Bank Security
# CUSTOMER_MFA_EMAIL_DELIVERY_REQUEST_TIMEOUT_MS=5000
# Password reset emails reuse the Resend/webhook adapter above. Preview mode
# fails closed: no usable token is exposed. Both application settings are required.
# PASSWORD_RECOVERY_APP_URL=https://stealth-trails.space
# PASSWORD_RECOVERY_ALLOWED_ORIGINS=https://stealth-trails.space
# Local testing: explicitly allow http://localhost:5173 in both settings.
# Webhook mode must deliver customer_password_recovery messages without tracking.
# CUSTOMER_MFA_EMAIL_DELIVERY_WEBHOOK_URL=https://mailer.example.com/send
# CUSTOMER_MFA_EMAIL_DELIVERY_BEARER_TOKEN=
# Trust only actual reverse proxy IPs/CIDRs. Empty uses the socket peer address.
# AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1,::1
# Operator auth
# During Supabase Auth decommission, operator bearer auth accepts app-issued
# operator JWTs signed by JWT_SECRET. SUPABASE_JWT_SECRET is a temporary bridge
# for legacy Supabase operator bearer tokens only.
SUPABASE_JWT_SECRET=
OPERATOR_RUNTIME_ENVIRONMENT=development
ALLOW_LEGACY_OPERATOR_API_KEY_AUTH=true
# OPERATOR_REQUIRED_MFA_ENVIRONMENTS=staging,production_like,production
INTERNAL_OPERATOR_API_KEY=
INTERNAL_WORKER_API_KEY=
# Sensitive operator control roles
# TRANSACTION_INTENT_DECISION_ALLOWED_OPERATOR_ROLES=operations_admin,risk_manager
# CUSTODY_OPERATION_ALLOWED_OPERATOR_ROLES=operations_admin,senior_operator,treasury
# Conservative default is operator review for all deposits. Configure per-asset
# auto-approval thresholds only when low-risk deposits may bypass initial review.
# DEPOSIT_AUTO_APPROVE_THRESHOLDS_JSON=[{"assetSymbol":"USDC","maxRequestedAmount":"1000"},{"assetSymbol":"ETH","maxRequestedAmount":"0.25"}]
# STAKING_GOVERNANCE_ALLOWED_OPERATOR_ROLES=treasury,risk_manager,compliance_lead
# STAKING_POOL_GOVERNANCE_REQUEST_ALLOWED_OPERATOR_ROLES=treasury,risk_manager,compliance_lead
# STAKING_POOL_GOVERNANCE_APPROVER_ALLOWED_OPERATOR_ROLES=risk_manager,compliance_lead
# STAKING_POOL_GOVERNANCE_EXECUTOR_ALLOWED_OPERATOR_ROLES=treasury

# Shared login bootstrap
# Local-development convenience only. Leave disabled unless you explicitly
# provide local-only credentials. This is blocked for staging, production-like,
# and production launch paths.
SHARED_LOGIN_ENABLED=false
# SHARED_LOGIN_EMAIL=
# SHARED_LOGIN_PASSWORD=
# SHARED_LOGIN_FIRST_NAME=Shared
# SHARED_LOGIN_LAST_NAME=Admin
# SHARED_LOGIN_SUPABASE_USER_ID=

# Ethereum / Hardhat local node defaults shown
RPC_URL=http://127.0.0.1:8545
STAKING_CONTRACT_ADDRESS=
ETHEREUM_PRIVATE_KEY=
# Governed custody and deployment metadata
# GOVERNED_CUSTODY_MANIFEST_PATH=packages/contracts/deployments/local.manifest.json
# GOVERNED_CUSTODY_MANIFEST_JSON=
# GOVERNED_EXECUTION_PACKAGE_SIGNER_PRIVATE_KEY=
# GOVERNED_LOAN_FUNDING_EXECUTION_MODE=governed_external
# GOVERNED_STAKING_WRITE_EXECUTION_MODE=governed_external

# Platform alert delivery and follow-up
# PLATFORM_ALERT_DELIVERY_TARGETS_JSON=[]
# PLATFORM_ALERT_DELIVERY_REQUEST_TIMEOUT_MS=5000
# PLATFORM_ALERT_AUTOMATION_POLICIES_JSON=[]
# PLATFORM_ALERT_DELIVERY_HEALTH_SLO_JSON={"lookbackHours":24,"minimumRecentDeliveries":3,"warningFailureRatePercent":25,"criticalFailureRatePercent":50,"warningPendingCount":2,"criticalPendingCount":5,"warningAverageDeliveryLatencyMs":15000,"criticalAverageDeliveryLatencyMs":60000,"warningConsecutiveFailures":2,"criticalConsecutiveFailures":3}
# PLATFORM_ALERT_REESCALATION_UNACKNOWLEDGED_SECONDS=900
# PLATFORM_ALERT_REESCALATION_UNOWNED_SECONDS=600
# PLATFORM_ALERT_REESCALATION_REPEAT_SECONDS=1800
